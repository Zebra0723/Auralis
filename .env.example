# --- Required ---------------------------------------------------------------

# PostgreSQL connection string used by the app.
# On serverless, point this at a connection pooler.
DATABASE_URL="postgresql://user:password@localhost:5432/auralis"

# Unpooled connection, used only for migrations (a transaction pooler cannot
# run them). Set it to the same value as DATABASE_URL if you are not pooling.
DIRECT_URL="postgresql://user:password@localhost:5432/auralis"

# 32 bytes, base64. Encrypts every stored third-party OAuth token.
# Generate with: openssl rand -base64 32
# Losing this means every connection must be re-authorised.
AURALIS_ENCRYPTION_KEY=""

# Absolute public URL. Must match the redirect URIs registered with each provider.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: one pair per service -----------------------------------------
# A service whose variables are absent shows as "Requires API configuration"
# in the UI and cannot be connected. Nothing else is affected.

# https://console.cloud.google.com/apis/credentials  (also covers Google Drive)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# https://entra.microsoft.com
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# https://api.slack.com/apps
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""

# https://marketplace.zoom.us/develop/create
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# https://app.asana.com/0/my-apps
ASANA_CLIENT_ID=""
ASANA_CLIENT_SECRET=""

# https://discord.com/developers/applications
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# https://trello.com/power-ups/admin
TRELLO_API_KEY=""
