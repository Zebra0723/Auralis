{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "crons": [
    {
      "path": "/api/cron/drain",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/cron/drain/route.ts": {
      "maxDuration": 60
    }
  }
}
